APP_ENV=production
DATABASE_URL=postgresql+asyncpg://energy:CHANGE_ME@postgres:5432/energy
HEARTBEAT_PROVIDER=onekommafive
HEARTBEAT_POLL_INTERVAL=60
LOG_LEVEL=INFO
ENABLE_TIMESCALEDB=true

# Legacy env fallback — production config is stored in DB via /config
HEARTBEAT_API_URL=
HEARTBEAT_API_KEY=

# Charge Amps bridge (collector + backend). Use provider=web when no External API key.
# CHARGEAMPS_PROVIDER=web
# CHARGEAMPS_MOCK=false
# CHARGEAMPS_API_KEY=
# CHARGEAMPS_EMAIL=
# CHARGEAMPS_PASSWORD=

# Caddy / TLS — public FQDN
CADDY_DOMAIN=emic.inacloud.se
# Optional plain-HTTP fallback when clients still reach the server by LAN IP
CADDY_LAN_HOST=192.168.50.54
# Uses Caddy internal CA until public DNS exists (see Caddyfile comments).
# Leave empty so the browser uses same-origin /api over HTTPS through Caddy
# NEXT_PUBLIC_API_BASE_URL=

# Fernet key for encrypting integration credentials at rest (Mercedes, Charge Amps, HeartBeat, Arctic Spa).
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EMIC_SECRET_KEY=
# Or persist via Docker volume using EMIC_SECRET_KEY_PATH (see docker-compose.yml).

# Required for docker compose (no default password)
POSTGRES_PASSWORD=CHANGE_ME

# Arctic Spa (MyArcticSpa cloud API). Per-site API keys in DB via /config.
ARCTIC_SPA_ENABLED=true
# ARCTIC_SPA_API_KEY=  # dev fallback only; prod uses DB per site

# Apple Widget API
WIDGET_STALE_SECONDS=120
WIDGET_SNAPSHOT_CACHE_SECONDS=15
WIDGET_SAVINGS_CACHE_SECONDS=300
WIDGET_RATE_LIMIT_PER_MINUTE=60

# Phase 1/2 performance & security (generated on first deploy if empty)
EMIC_ADMIN_TOKEN=
SOLAR_FORECAST_SYNC_REFRESH_ON_READ=false
FINANCIAL_AGGREGATES_ENABLED=true

# Optional shared L2 cache (docker-compose default: redis://redis:6379/0). Leave empty for memory-only.
REDIS_URL=redis://redis:6379/0
# SNAPSHOT_REDIS_CACHE_TTL_SECONDS=60
# DASHBOARD_REDIS_CACHE_TTL_SECONDS=30
# FINANCIAL_REDIS_CACHE_TTL_SECONDS=300
# SOLAR_FORECAST_REDIS_CACHE_TTL_SECONDS=1800
SOLAR_FORECAST_L1_WARM_TTL_SECONDS=300
# HORIZON_OPTIMIZER_REDIS_CACHE_TTL_SECONDS=300
# ENERGY_CONTROL_PROVIDER=noop
ENERGY_CONTROL_PROVIDER=chargeamps
ENERGY_CONTROL_COLLECTOR_ENABLED=true

# TimescaleDB retention (PostgreSQL production only; requires ENABLE_TIMESCALEDB=true)
TIMESCALE_RETENTION_ENABLED=true
# Compress energy_readings chunks older than 7 days (requires retention enabled first)
TIMESCALE_COMPRESSION_ENABLED=true

# ChargeFinder (away-charging station lookup when Mercedes GPS is available)
CHARGEFINDER_ENABLED=true
CHARGEFINDER_MODE=WEB
CHARGEFINDER_SEARCH_RADIUS_M=150
CHARGEFINDER_TIMEOUT_SECONDS=15
CHARGEFINDER_CACHE_TTL_SECONDS=604800
CHARGEFINDER_COOLDOWN_SECONDS=900
