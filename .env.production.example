APP_ENV=production
DATABASE_URL=postgresql+asyncpg://energy:CHANGE_ME@postgres:5432/energy
HEARTBEAT_PROVIDER=onekommafive
HEARTBEAT_POLL_INTERVAL=60
LOG_LEVEL=INFO
ENABLE_TIMESCALEDB=true

# Legacy env fallback — production config is stored in DB via /config
HEARTBEAT_API_URL=
HEARTBEAT_API_KEY=

# Charge Amps bridge (collector + backend). Use provider=web when no External API key.
# CHARGEAMPS_PROVIDER=web
# CHARGEAMPS_MOCK=false
# CHARGEAMPS_API_KEY=
# CHARGEAMPS_EMAIL=
# CHARGEAMPS_PASSWORD=

# Caddy / TLS — use server IP or domain
# CADDY_DOMAIN=your-server.example.com

# Fernet key for encrypting integration credentials at rest (Mercedes password/tokens).
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EMIC_SECRET_KEY=
# Or persist via Docker volume using EMIC_SECRET_KEY_PATH (see docker-compose.yml).

# Arctic Spa (MyArcticSpa cloud API). Per-site API keys in DB via /config.
ARCTIC_SPA_ENABLED=true
# ARCTIC_SPA_API_KEY=  # dev fallback only; prod uses DB per site

# Apple Widget API
WIDGET_STALE_SECONDS=120
WIDGET_SNAPSHOT_CACHE_SECONDS=15
WIDGET_SAVINGS_CACHE_SECONDS=300
WIDGET_RATE_LIMIT_PER_MINUTE=60
