# EMIC reverse proxy — TLS termination at Caddy, HTTP to internal services.
#
# Production (.env):
#   CADDY_DOMAIN=emic.inacloud.se
#   CADDY_LAN_HOST=192.168.50.54          # LAN HTTPS; plain HTTP redirects to HTTPS
#
# TLS: uses Caddy's internal CA by default (works with LAN / split-horizon DNS).
# When emic.inacloud.se has a public A-record and ports 80+443 are forwarded,
# remove the "tls internal" line below for automatic Let's Encrypt instead.
#
# Trust the internal CA on client machines (optional, removes browser warnings):
#   docker compose exec caddy cat /data/caddy/pki/ca/root.crt

(emic_app) {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /sprint-b-fixtures/* {
		root * /srv/sprint-b-fixtures
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Primary site — HTTPS on the FQDN.
# Use Caddy's internal CA until emic.inacloud.se has a public A-record and ports
# 80+443 are reachable from the internet; then switch to automatic Let's Encrypt
# by replacing "tls internal" with no tls directive (or set CADDY_TLS=auto).
{$CADDY_DOMAIN:localhost} {
	tls internal
	import emic_app
}

# Redirect plain HTTP on the FQDN to HTTPS.
http://{$CADDY_DOMAIN:localhost} {
	redir https://{host}{uri} permanent
}

# LAN IP — HTTPS for kiosks and operators; plain HTTP redirects to HTTPS.
https://{$CADDY_LAN_HOST:192.168.50.54} {
	tls internal
	import emic_app
}

http://{$CADDY_LAN_HOST:192.168.50.54} {
	redir https://{host}{uri} permanent
}

# Internal Docker-only artifact fixture server (no TLS, no redirect).
:8080 {
	root * /srv/sprint-b-fixtures
	file_server
}
