APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./energy-dev.db
HEARTBEAT_PROVIDER=mock
HEARTBEAT_POLL_INTERVAL=30
LOG_LEVEL=DEBUG
ENABLE_TIMESCALEDB=false

# --- Host ports (GH-46) ---
# Every value below is the default that already applies when the variable is
# unset or empty, so uncommenting one unchanged is a no-op. Change a value to
# move that port. Only the host side moves: services keep reaching each other
# on their in-container ports (the Caddyfile's `reverse_proxy backend:8000`,
# for one), so nothing else needs changing alongside an override.
#
# HTTP_PORT, HTTPS_PORT and POSTGRES_PORT are read straight out of this file by
# `docker compose` once it has been copied to `.env`. BACKEND_PORT and
# FRONTEND_PORT are read by the Makefile, which does not load `.env` -- export
# those in your shell or pass them on the command line instead
# (`make backend-dev BACKEND_PORT=9001`).

# docker-compose.yml, caddy
#HTTP_PORT=80
#HTTPS_PORT=443
# docker-compose.dev-db.yml, postgres
#POSTGRES_PORT=5432
# Makefile, backend-dev (uvicorn)
#BACKEND_PORT=8000
# Makefile, frontend-dev (next dev, via PORT)
#FRONTEND_PORT=3000
