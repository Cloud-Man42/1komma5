{
  "project": {
    "name": "EMIC",
    "full_name": "Energy Monitoring In a Cloud",
    "repository": "1komma5",
    "analysis_date": "2026-09-03",
    "migration_head": "057_energy_control_interface",
    "description": "Home energy monitoring and partial EMS for Swedish residential sites",
    "production_example_host": "emic.inacloud.se",
    "maturity": "Advanced monitor + partial load optimizer"
  },
  "architecture": {
    "pattern": "monolith_collector_snapshot",
    "layers": [
      "clients",
      "caddy_reverse_proxy",
      "nextjs_frontend",
      "fastapi_backend",
      "energy_core_domain",
      "collector",
      "postgresql_timescaledb",
      "external_integrations"
    ],
    "services_count": 5,
    "api_endpoints_count": 158,
    "background_worker": "collector_asyncio_loop",
    "realtime": "http_polling_primary_sse_secondary",
    "auth_model": "open_admin_api_lan_assumption_device_tokens_widget_display"
  },
  "stack": {
    "backend": {
      "language": "Python 3.12",
      "framework": "FastAPI",
      "server": "Uvicorn",
      "orm": "SQLAlchemy 2 async",
      "migrations": "Alembic",
      "package_manager": "uv"
    },
    "frontend": {
      "framework": "Next.js 15",
      "ui": "React 19",
      "language": "TypeScript",
      "charts": "Recharts",
      "tests": "Vitest"
    },
    "database": {
      "production": "PostgreSQL 16 + TimescaleDB",
      "development": "SQLite",
      "tables_approx": 60,
      "migrations_count": 57
    },
    "infrastructure": {
      "container": "Docker Compose",
      "proxy": "Caddy 2",
      "ci": "GitHub Actions pytest + npm test"
    },
    "clients": [
      "browser_nextjs",
      "raspberry_pi_kiosk",
      "apple_ios_widget",
      "windows_tray_dotnet8"
    ]
  },
  "services": [
    {"name": "caddy", "port": "80,443", "role": "tls_reverse_proxy"},
    {"name": "frontend", "port": 3000, "role": "nextjs_standalone"},
    {"name": "backend", "port": 8000, "role": "fastapi_rest_api"},
    {"name": "collector", "port": null, "role": "background_poll_enrichment"},
    {"name": "postgres", "port": 5432, "role": "timescaledb_storage"}
  ],
  "databases": [
    {
      "name": "energy",
      "engine": "postgresql_timescaledb",
      "hypertables": ["energy_readings", "consumer_samples", "vehicle_state_history"],
      "continuous_aggregates": ["energy_readings_5min", "energy_readings_1hour"],
      "retention_policy": "partial_solar_14d_prices_90d_raw_none",
      "dev_engine": "sqlite"
    }
  ],
  "integrations": [
    {"name": "1komma5_heartbeat", "status": "active", "protocol": "https_rest_jwt", "purpose": "readings_prices_live_overview"},
    {"name": "sungrow", "status": "active_via_heartbeat", "protocol": "heartbeat_proxy", "purpose": "inverter_telemetry_balance"},
    {"name": "charge_amps", "status": "active", "protocol": "https_rest_v5", "purpose": "ev_charger_control"},
    {"name": "mercedes", "status": "active", "protocol": "websocket_rest", "purpose": "vehicle_telemetry_commands"},
    {"name": "arctic_spa", "status": "optional", "protocol": "https_rest", "purpose": "spa_monitoring_control"},
    {"name": "chargefinder", "status": "active", "protocol": "web_scrape", "purpose": "away_charging_lookup"},
    {"name": "smhi", "status": "active", "protocol": "https_open_data", "purpose": "solar_radiation"},
    {"name": "dmi", "status": "active", "protocol": "https_open_data", "purpose": "weather_harmonie"},
    {"name": "open_meteo", "status": "active", "protocol": "https", "purpose": "weather_forecast_archive"},
    {"name": "nord_pool", "status": "label_only", "protocol": "via_heartbeat", "purpose": "spot_prices"},
    {"name": "modbus", "status": "removed", "protocol": null, "purpose": null},
    {"name": "sensibo", "status": "not_in_codebase", "protocol": null, "purpose": null},
    {"name": "stripe", "status": "not_in_codebase", "protocol": null, "purpose": null},
    {"name": "ebecon", "status": "unknown", "protocol": null, "purpose": null}
  ],
  "background_jobs": [
    {"name": "collector_main_loop", "interval_seconds": "30-60", "file": "collector/app/collector.py"},
    {"name": "heartbeat_readings_ingest", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "price_engine_refresh", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "live_overview_prefetch", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "arctic_spa_poll", "parent": "collector_main_loop", "interval_seconds": "60-15_cleaning"},
    {"name": "ev_accounting", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "vehicle_charge_sessions", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "energy_balance", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "solar_forecast_refresh", "parent": "collector_main_loop", "interval_seconds": 1800},
    {"name": "forecast_learning_sync", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "energy_control_sync", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "energy_aggregation_rollup", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "snapshot_writer", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "smart_charging_engine", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "virtual_heartbeat_bridge", "parent": "collector_main_loop", "interval_seconds": "30-60"},
    {"name": "vehicle_integration_supervisor", "interval_seconds": "adaptive_30-300", "file": "energy_core/vehicles/supervisor.py"}
  ],
  "api_endpoints": [
    {"method": "GET", "path": "/health", "module": "main.py"},
    {"method": "GET", "path": "/api/sites", "module": "sites.py"},
    {"method": "GET", "path": "/api/sites/{slug}/dashboard", "module": "dashboard.py"},
    {"method": "GET", "path": "/api/sites/{slug}/snapshot", "module": "snapshot.py"},
    {"method": "GET", "path": "/api/sites/{slug}/live-stream", "module": "snapshot.py", "type": "sse"},
    {"method": "GET", "path": "/api/sites/{slug}/readings", "module": "readings.py"},
    {"method": "GET", "path": "/api/sites/{slug}/financial-stats", "module": "readings.py"},
    {"method": "GET", "path": "/api/sites/{slug}/market-prices", "module": "prices.py"},
    {"method": "GET", "path": "/api/sites/{slug}/solar/forecast", "module": "solar_forecast.py", "perf_critical": true},
    {"method": "GET", "path": "/api/sites/{slug}/price-engine/current", "module": "price_engine.py"},
    {"method": "GET", "path": "/api/sites/{slug}/energy-strategy/current", "module": "price_engine.py"},
    {"method": "GET", "path": "/api/sites/{slug}/ev-chargers", "module": "ev_chargers.py"},
    {"method": "GET", "path": "/api/sites/{slug}/vehicles", "module": "vehicles.py"},
    {"method": "GET", "path": "/api/sites/{slug}/spa/status", "module": "spa.py"},
    {"method": "GET", "path": "/api/v1/display/overview/{slug}", "module": "display.py", "auth": "display.read"},
    {"method": "GET", "path": "/api/v1/widget/status/{site_id}", "module": "widget.py", "auth": "widget.read"},
    {"method": "GET", "path": "/api/system/performance", "module": "system.py"},
    {"method": "GET", "path": "/api/system/heartbeat-config", "module": "system.py"},
    {"method": "GET", "path": "/semp", "module": "semp.py", "prefix": "root"},
    {"note": "Full list of 158 endpoints documented in analysis agent inventory; sample above covers critical paths"}
  ],
  "dashboards": [
    {"name": "Intelligence Overview", "route": "/sites/[slug]", "poll_seconds": "15-30", "primary_api": "/api/sites/{slug}/dashboard"},
    {"name": "Energy", "route": "/sites/[slug]/energy", "poll_seconds": 60, "primary_api": "/api/sites/{slug}/dashboard"},
    {"name": "Solar", "route": "/sites/[slug]/solar", "poll_seconds": 30, "primary_api": "/api/sites/{slug}/solar/forecast"},
