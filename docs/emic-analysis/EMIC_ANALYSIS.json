  ],
  "performance_findings": [
    {"id": "P-API-01", "severity": "CRITICAL", "file": "backend/app/api/solar_forecast.py", "problem": "p95 34034ms at 10 concurrent users", "solution": "collector snapshot for forecast GET"},
    {"id": "P-DB-01", "severity": "HIGH", "file": "packages/energy-core/src/energy_core/db/repositories.py", "problem": "list_financial_stats loads all readings to Python", "solution": "pre-aggregate daily financial stats"},
    {"id": "P-API-02", "severity": "HIGH", "file": "backend/app/api/snapshot.py", "problem": "SSE polls DB every 1s per client", "solution": "redis pubsub push from collector"},
    {"id": "P-CACHE-01", "severity": "HIGH", "file": "packages/energy-core/src/energy_core/cache/service.py", "problem": "process-local L1 cache only", "solution": "redis shared cache"},
    {"id": "P-FE-01", "severity": "HIGH", "file": "frontend/src/lib/api.ts", "problem": "cache no-store on all fetches", "solution": "etag on snapshot endpoints"},
    {"id": "P-FE-02", "severity": "MEDIUM", "file": "frontend/src/app/sites/[slug]/page.tsx", "problem": "duplicate dashboard polls 15s and 30s", "solution": "single refresh coordinator"},
    {"id": "P-FE-03", "severity": "MEDIUM", "file": "frontend/src/lib/useEconomyDashboardData.ts", "problem": "no auto refresh", "solution": "add setInterval"},
    {"id": "P-FE-04", "severity": "MEDIUM", "file": "frontend/src/lib/usePiDashboardData.ts", "problem": "4s poll vs 3s server cache", "solution": "align to 8-10s or use SSE"},
    {"id": "P-COL-01", "severity": "HIGH", "file": "collector/app/collector.py", "problem": "15 sequential enrichment steps per cycle", "solution": "prioritized sub-loops"},
    {"id": "P-DB-03", "severity": "MEDIUM", "file": "alembic/versions/002_timescaledb.py", "problem": "no raw data retention policy", "solution": "timescale retention compression"}
  ],
  "database_findings": [
    {"severity": "HIGH", "issue": "unbounded energy_readings growth", "recommendation": "timescale retention 90d raw"},
