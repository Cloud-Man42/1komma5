# EMIC local proxy for Raspberry Pi kiosk.
# Token is injected from environment — never stored in this file.
#
# Install: copy to /etc/emic/Caddyfile, set EMIC_KIOSK_TOKEN in /etc/emic/kiosk.env
# and EMIC_SERVER / EMIC_SERVER_SCHEME in /etc/emic/display.env. The upstream is
# a placeholder so a Pi at another site (or reaching EMIC over the internet)
# needs no edit to this file.
{
	auto_https off
	admin off
}

:8080 {
	@api path /api/*

	reverse_proxy @api {$EMIC_SERVER_SCHEME:http}://{$EMIC_SERVER:192.168.50.54} {
		header_up Host {$EMIC_SERVER:192.168.50.54}
		header_up Authorization "Bearer {env.EMIC_KIOSK_TOKEN}"
	}

	reverse_proxy {$EMIC_SERVER_SCHEME:http}://{$EMIC_SERVER:192.168.50.54} {
		header_up Host {$EMIC_SERVER:192.168.50.54}
	}
}
