# EMIC local proxy for Raspberry Pi kiosk.
# Token is injected from environment — never stored in this file.
#
# Install: copy to /etc/emic/Caddyfile, set EMIC_KIOSK_TOKEN in /etc/emic/kiosk.env
# and EMIC_SERVER / EMIC_SERVER_SCHEME / EMIC_SERVER_HOST in /etc/emic/display.env.
# Prefer https://emic.inacloud.se (split-horizon DNS) over raw LAN IP.
{
	auto_https off
	admin off
}

:8080 {
	@api path /api/*

	reverse_proxy @api {$EMIC_SERVER_SCHEME:https}://{$EMIC_SERVER:emic.inacloud.se} {
		header_up Host {$EMIC_SERVER_HOST:emic.inacloud.se}
		header_up Authorization "Bearer {env.EMIC_KIOSK_TOKEN}"
	}

	reverse_proxy {$EMIC_SERVER_SCHEME:https}://{$EMIC_SERVER:emic.inacloud.se} {
		header_up Host {$EMIC_SERVER_HOST:emic.inacloud.se}
	}
}
