<Window x:Class="EMIC.Tray.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EMIC"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
  <Border Background="#FF1E1E1E"
          BorderBrush="#FF3A3A3A"
          BorderThickness="1"
          CornerRadius="12"
          Padding="16">
    <StackPanel>
      <DockPanel Margin="0,0,0,8">
        <TextBlock x:Name="SiteTitle"
                   Text="EMIC"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   DockPanel.Dock="Left" />
        <Border x:Name="StaleBadge"
                Background="#665C00"
                CornerRadius="6"
                Padding="6,2"
                HorizontalAlignment="Right"
                Visibility="Collapsed">
          <TextBlock Text="Inaktuell" Foreground="#FFEECC55" FontSize="11" />
        </Border>
      </DockPanel>

      <ComboBox x:Name="SiteSelector"
                Margin="0,0,0,8"
                MinHeight="32" />

      <TextBlock x:Name="DecisionText"
                 TextWrapping="Wrap"
                 Foreground="#FFB8FFB8"
                 FontSize="14"
                 Margin="0,0,0,12" />

      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
          <TextBlock Text="Sol" Foreground="#FFAAAAAA" FontSize="11" />
          <TextBlock x:Name="SolarValue" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
          <TextBlock Text="Hus" Foreground="#FFAAAAAA" FontSize="11" />
          <TextBlock x:Name="HouseValue" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
          <TextBlock Text="Batteri" Foreground="#FFAAAAAA" FontSize="11" />
          <TextBlock x:Name="BatteryValue" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
          <TextBlock Text="Nät" Foreground="#FFAAAAAA" FontSize="11" />
          <TextBlock x:Name="GridValue" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
          <TextBlock Text="Elbil" Foreground="#FFAAAAAA" FontSize="11" />
          <TextBlock x:Name="EvValue" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="ErrorText"
                 Foreground="#FFFF8888"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 Visibility="Collapsed" />

      <TextBlock x:Name="MetaText"
                 Foreground="#FF888888"
                 FontSize="11"
                 Margin="0,0,0,12" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Uppdatera"
                Click="RefreshButton_Click"
                Margin="0,0,8,0"
                Padding="12,6" />
        <Button Content="Inställningar"
                Click="SettingsButton_Click"
                Padding="12,6" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
